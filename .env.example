PUBLIC_DATA_SERVICE_KEY=
# 정확한 operation/parameter/response 규격은 config/public-api/*.json에서 관리합니다.
# 병원 서비스 base URL만 확인됨: https://apis.data.go.kr/1741000/animal_hospitals

NEXT_PUBLIC_KAKAO_MAP_JS_KEY=
KAKAO_REST_API_KEY=

ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

CRON_SECRET=

NEXT_PUBLIC_GA_ID=

GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=

ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-7368372468718077

# mock은 명시적인 개발 환경에서만 허용됩니다. 기본값은 database입니다.
DATA_MODE=database

# 별도 폐기 가능한 PostGIS 테스트 DB. production DATABASE_URL을 사용하지 마세요.
TEST_DATABASE_URL=
